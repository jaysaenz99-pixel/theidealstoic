# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the template, which holds no secrets.
!.env.local.example

# vercel
.vercel

# Personal machine settings — yours alone, not part of the site.
.claude/settings.local.json

# Tooling skills installed on this Mac. Hundreds of files, including font
# binaries, none of which the website needs to build or run.
.claude/skills/

# Source material. The originals stay on this Mac; the site ships the processed
# copies in /public. Keeping them out means an unreleased manuscript summary and
# a family photo are not published if this repository is ever public.
/IMG_*.jpeg
/IMG_*.JPG
/*.docx

# typescript
*.tsbuildinfo
next-env.d.ts
