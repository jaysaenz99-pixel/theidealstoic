# Copy this file to `.env.local` and fill in the three values.
# `.env.local` is gitignored and never leaves your machine.
# See SETUP.md for where each value lives in the dashboards.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → Data API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Dashboard → Project Settings → API Keys → the "anon" / "publishable" key.
# This key is meant to be public. Row Level Security in supabase/schema.sql is
# what limits it to inserting a row into subscribers.
#
# Do NOT put the service_role / secret key here. Nothing in this site needs it.
SUPABASE_ANON_KEY=

# ── ImageKit ─────────────────────────────────────────────────────────────────
# Dashboard → Developer options → URL-endpoints. Looks like:
#   https://ik.imagekit.io/your_imagekit_id
# No trailing slash.
#
# Leave this blank and the site serves the images from /public instead. Nothing
# breaks; you just lose ImageKit's resizing and CDN.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Your ImageKit public key. Public by design — it identifies the account and is
# only needed if the site ever uploads images from the browser. Rendering does
# not use it.
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_M9Bh+p4wcO7bmyBMC5xlwnPx2Wo=

# Note: uploading from this project would need your PRIVATE key. Do not paste it
# into chat or into any file here — upload through the ImageKit dashboard instead.
